{
  "name": "islamic-community-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @icp/api dev",
    "dev:web": "pnpm --filter @icp/web dev",
    "build": "pnpm --filter @icp/api build && pnpm --filter @icp/web build",
    "lint": "eslint packages/*/src/**/*.{ts,tsx}",
    "lint:fix": "eslint packages/*/src/**/*.{ts,tsx} --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:api": "pnpm --filter @icp/api test",
    "test:web": "pnpm --filter @icp/web test",
    "test:watch": "vitest",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,css,json}\"",
    "db:generate": "pnpm --filter @icp/api db:generate",
    "db:migrate": "pnpm --filter @icp/api db:migrate",
    "db:push": "pnpm --filter @icp/api db:push",
    "db:studio": "pnpm --filter @icp/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
